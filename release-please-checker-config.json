{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "3e48ebaccb8eadd9672419d517173ac45a02e65d",
  "release-type": "rust",
  "always-update": true,
  "separate-pull-requests": true,
  "group-pull-request-title-pattern": "chore(${branch}): release pi-recipe-check ${version}",
  "packages": {
    "crates/pi-recipe-check": {
      "release-type": "rust",
      "component": "pi-recipe-check",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true
    },
    "bindings/python": {
      "release-type": "rust",
      "component": "pi-recipe-check-python",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true
    }
  },
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "pi-recipe-check",
      "components": [
        "pi-recipe-check",
        "pi-recipe-check-python"
      ],
      "merge": true
    }
  ],
  "bump-minor-pre-major": true
}
