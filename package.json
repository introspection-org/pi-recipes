{
	"name": "@introspection-ai/recipes",
	"version": "0.19.0",
	"description": "The open format for vertical agents, built on Pi.",
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist",
		"vendor/mcp-client",
		"vendor/introspection-recipe-check",
		"docs",
		"README.md",
		"package.json"
	],
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/introspection-org/recipes.git"
	},
	"bugs": {
		"url": "https://github.com/introspection-org/recipes/issues"
	},
	"homepage": "https://github.com/introspection-org/recipes#readme",
	"publishConfig": {
		"access": "public",
		"tag": "latest"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./interactions": {
			"types": "./dist/interactions.d.ts",
			"import": "./dist/interactions.js"
		},
		"./extensions": {
			"types": "./dist/api/extensions.d.ts",
			"import": "./dist/api/extensions.js"
		},
		"./mcp": {
			"types": "./dist/api/mcp.d.ts",
			"import": "./dist/api/mcp.js"
		},
		"./pi-extension": {
			"types": "./dist/pi-extension.d.ts",
			"import": "./dist/pi-extension.js"
		},
		"./agents": {
			"types": "./dist/agents.d.ts",
			"import": "./dist/agents.js"
		},
		"./recipe": {
			"types": "./dist/recipe/resolve.d.ts",
			"import": "./dist/recipe/resolve.js"
		},
		"./session": {
			"types": "./dist/api/session.d.ts",
			"import": "./dist/api/session.js"
		},
		"./test-utils": {
			"types": "./dist/test-utils.d.ts",
			"import": "./dist/test-utils.js"
		},
		"./inspect": {
			"types": "./dist/inspect.d.ts",
			"import": "./dist/inspect.js"
		}
	},
	"pi": {
		"extensions": [
			"./dist/pi-extension.js"
		]
	},
	"scripts": {
		"build": "pnpm build:ts && pnpm build:native",
		"build:ts": "rm -rf dist && tsc && node scripts/build-mcp-daemon.mjs",
		"build:native": "cargo build --release -p pi-mcp-client && cargo build --release -p introspection-recipe-check --bin introspection-recipe-check && node scripts/package-mcp-client.mjs && node scripts/package-introspection-recipe-check.mjs",
		"bench:mcp-client": "pnpm build:ts && cargo build --release -p pi-mcp-client && node scripts/benchmark-mcp-client.mjs",
		"prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "pnpm build:ts && cargo test -p pi-mcp-client -p introspection-recipe-check && cargo build -p pi-mcp-client && cargo build -p introspection-recipe-check --bin introspection-recipe-check && MCP_CLIENT_BIN=target/debug/mcp-client node scripts/package-mcp-client.mjs && vitest run",
		"pack:check": "pnpm pack --dry-run --json | node scripts/check-npm-pack.mjs",
		"clean": "rm -rf dist .turbo node_modules target vendor/mcp-client vendor/introspection-recipe-check"
	},
	"dependencies": {
		"@introspection-sdk/introspection-pi": "^0.19.1",
		"@opentelemetry/api": "^1.9.1",
		"ajv": "^8.20.0",
		"mcporter": "0.13.0",
		"yaml": "^2.9.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "^0.82.0",
		"@earendil-works/pi-ai": "^0.82.0",
		"@earendil-works/pi-coding-agent": "^0.82.0",
		"@earendil-works/pi-tui": "^0.82.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "0.84.1",
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@earendil-works/pi-tui": "0.84.1",
		"@types/node": "^26.1.2",
		"esbuild": "^0.28.1",
		"typebox": "^1.0.56",
		"typescript": "^7.0.2",
		"vitest": "^4.0.18"
	}
}
