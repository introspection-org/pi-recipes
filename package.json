{
  "name": "@introspection-ai/pi-recipes",
  "version": "0.9.7",
  "description": "Local session tooling for package-based workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist/child-agent.d.ts",
    "dist/child-agent.js",
    "dist/child-agent-completions.d.ts",
    "dist/child-agent-completions.js",
    "dist/child-agent-store.d.ts",
    "dist/child-agent-store.js",
    "dist/cli.d.ts",
    "dist/cli.js",
    "dist/direct-cli.d.ts",
    "dist/direct-cli.js",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/interactions.d.ts",
    "dist/interactions.js",
    "dist/mcp.d.ts",
    "dist/mcp.js",
    "dist/mcp-cli.d.ts",
    "dist/mcp-cli.js",
    "dist/mcp-client.d.ts",
    "dist/mcp-client.js",
    "dist/mcp-daemon-client.d.ts",
    "dist/mcp-daemon-client.js",
    "dist/mcp-catalog.d.ts",
    "dist/mcp-catalog.js",
    "dist/mcp-command-context.d.ts",
    "dist/mcp-command-context.js",
    "dist/mcp-daemon.d.ts",
    "dist/mcp-daemon.js",
    "dist/mcp-daemon-protocol.d.ts",
    "dist/mcp-daemon-protocol.js",
    "dist/mcp-run-worker.d.ts",
    "dist/mcp-run-worker.js",
    "dist/mcp-cli-help.d.ts",
    "dist/mcp-cli-help.js",
    "dist/mcp-cli-policy.d.ts",
    "dist/mcp-cli-policy.js",
    "dist/mcp-contract.d.ts",
    "dist/mcp-contract.js",
    "dist/package-info.d.ts",
    "dist/package-info.js",
    "dist/pi-extension.d.ts",
    "dist/pi-extension.js",
    "dist/recipe-dev.d.ts",
    "dist/recipe-dev.js",
    "dist/recipe-evals.d.ts",
    "dist/recipe-evals.js",
    "dist/recipe-mcp-config.d.ts",
    "dist/recipe-mcp-config.js",
    "dist/recipe-model.d.ts",
    "dist/recipe-model.js",
    "dist/recipe-agent.d.ts",
    "dist/recipe-agent.js",
    "dist/recipe-check.d.ts",
    "dist/recipe-check.js",
    "dist/recipe-package.d.ts",
    "dist/recipe-package.js",
    "dist/recipe-publish.d.ts",
    "dist/recipe-publish.js",
    "dist/recipe-store.d.ts",
    "dist/recipe-store.js",
    "dist/recipe-telemetry.d.ts",
    "dist/recipe-telemetry.js",
    "harbor/pi_recipe_agent.py",
    "vendor/recipe-check",
    "vendor/mcp-client",
    "docs",
    "README.md",
    "package.json"
  ],
  "bin": {
    "recipes": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/introspection-org/pi-recipes.git"
  },
  "bugs": {
    "url": "https://github.com/introspection-org/pi-recipes/issues"
  },
  "homepage": "https://github.com/introspection-org/pi-recipes#readme",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interactions": {
      "types": "./dist/interactions.d.ts",
      "import": "./dist/interactions.js"
    },
    "./pi-extension": {
      "types": "./dist/pi-extension.d.ts",
      "import": "./dist/pi-extension.js"
    },
    "./recipe-store": {
      "types": "./dist/recipe-store.d.ts",
      "import": "./dist/recipe-store.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi-extension.js"
    ]
  },
  "scripts": {
    "build": "pnpm build:ts && pnpm build:native",
    "build:ts": "rm -rf dist && tsc && chmod +x dist/cli.js",
    "build:native": "cargo build --release -p pi-recipe-check -p pi-mcp-client && node scripts/package-recipe-check.mjs && node scripts/package-mcp-client.mjs",
    "bench:mcp-client": "pnpm build:ts && cargo build --release -p pi-mcp-client && node scripts/benchmark-mcp-client.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm build:ts && cargo test -p pi-mcp-client && cargo build -p pi-mcp-client -p pi-recipe-check && MCP_CLIENT_BIN=target/debug/mcp-client node scripts/package-mcp-client.mjs && vitest run",
    "pack:check": "npm pack --dry-run --json | node scripts/check-npm-pack.mjs",
    "clean": "rm -rf dist .turbo node_modules target vendor/recipe-check vendor/mcp-client"
  },
  "dependencies": {
    "mcporter": "0.12.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "@types/node": "^22.10.0",
    "typebox": "^1.0.56",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
