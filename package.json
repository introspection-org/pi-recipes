{
  "name": "@tfidfwastaken/local-session-tools",
  "version": "0.1.0",
  "description": "Local session tooling for package-based workflows.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist/child-agent.d.ts",
    "dist/child-agent.js",
    "dist/cli.d.ts",
    "dist/cli.js",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/pi-extension.d.ts",
    "dist/pi-extension.js",
    "dist/recipe-agent.d.ts",
    "dist/recipe-agent.js",
    "dist/recipe-package.d.ts",
    "dist/recipe-package.js",
    "dist/recipe-store.d.ts",
    "dist/recipe-store.js",
    "docs",
    "README.md",
    "package.json"
  ],
  "bin": {
    "recipe": "dist/cli.js",
    "recipes": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "testing"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi-extension": {
      "types": "./dist/pi-extension.d.ts",
      "import": "./dist/pi-extension.js"
    },
    "./recipe-store": {
      "types": "./dist/recipe-store.d.ts",
      "import": "./dist/recipe-store.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi-extension.js"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:system": "node test/recipes-system.mjs",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.75.4",
    "@earendil-works/pi-ai": "0.75.4",
    "@earendil-works/pi-coding-agent": "0.75.4",
    "@earendil-works/pi-tui": "0.75.5",
    "@types/node": "^22.10.0",
    "typebox": "^1.0.56",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
