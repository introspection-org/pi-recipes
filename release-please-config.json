{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "3e48ebaccb8eadd9672419d517173ac45a02e65d",
  "release-type": "node",
  "include-component-in-tag": false,
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore(${branch}): release pi-recipe-check libraries",
  "packages": {
    ".": {
      "release-type": "node",
      "component": "pi-recipes",
      "separate-pull-requests": true,
      "bump-minor-pre-major": true
    },
    "crates/pi-recipe-check": {
      "release-type": "rust",
      "component": "pi-recipe-check",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true
    },
    "bindings/python": {
      "release-type": "rust",
      "component": "pi-recipe-check-python",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true
    },
    "packages/recipe-check-darwin-arm64": {
      "release-type": "node",
      "component": "recipe-check-darwin-arm64",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true
    },
    "packages/recipe-check-darwin-x64": {
      "release-type": "node",
      "component": "recipe-check-darwin-x64",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true
    },
    "packages/recipe-check-linux-arm64": {
      "release-type": "node",
      "component": "recipe-check-linux-arm64",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true
    },
    "packages/recipe-check-linux-x64": {
      "release-type": "node",
      "component": "recipe-check-linux-x64",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true
    },
    "packages/recipe-check-win32-x64": {
      "release-type": "node",
      "component": "recipe-check-win32-x64",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true
    }
  },
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "pi-recipe-check",
      "components": [
        "pi-recipe-check",
        "pi-recipe-check-python"
      ],
      "merge": false
    }
  ],
  "bump-minor-pre-major": true
}
